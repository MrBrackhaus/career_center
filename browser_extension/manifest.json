{
  "manifest_version": 3,
  "name": "Bewerbungszentrale Companion",
  "version": "1.1.0",
  "description": "Importiert Stellenanzeigen und füllt Bewerbungsformulare automatisch mit deinen Profildaten aus – lokal, sicher, DSGVO-konform.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bewerbungszentrale"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:47392/",
    "http://localhost:47392/"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content_autofill.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@bewerbungszentrale.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
